#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
SKILL_FILE="${PLUGIN_ROOT}/skills/tight-prose/SKILL.md"

if [[ ! -f "${SKILL_FILE}" ]]; then
    exit 0
fi

reinforcement=$(awk '
    /<!-- BEGIN REINFORCEMENT -->/ { flag=1; next }
    /<!-- END REINFORCEMENT -->/   { flag=0 }
    flag
' "${SKILL_FILE}")

if [[ -z "${reinforcement}" ]]; then
    exit 0
fi

escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

escaped=$(escape_for_json "${reinforcement}")

cat <<EOF
{
  "hookSpecificOutput": {
    "hookEventName": "UserPromptSubmit",
    "additionalContext": "${escaped}"
  }
}
EOF

exit 0
